{
    "name": "configdirector/laravel-sample",
    "description": "Laravel sample application for the ConfigDirector PHP server SDK",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "configdirector/server-sdk": "dev-main",
        "laravel/framework": "^13.42"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../packages/server-sdk",
            "options": {
                "versions": {
                    "configdirector/server-sdk": "dev-main"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.36"
        },
        "sort-packages": true
    }
}
