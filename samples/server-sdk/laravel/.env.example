# Copy to .env and fill in. .env is gitignored; never commit real keys.
#
#   cd samples/server-sdk/laravel && cp .env.example .env
#
# A variable set in the environment wins over the same variable in .env.

# Your ConfigDirector server SDK key. A secret.
CONFIGDIRECTOR_SERVER_KEY=fake-sample-key

# Only needed when routing through a proxy to reach ConfigDirector.
# CONFIGDIRECTOR_BASE_URL=https://proxy.internal/configdirector

# polling or offline.
CONFIGDIRECTOR_MODE=polling

# How long initialize() waits for values, in milliseconds.
CONFIGDIRECTOR_TIMEOUT=3000

# The lowest level the SDK writes: debug, info, notice, warning, error, critical, alert or emergency.
# At info the streaming process writes when it starts and stops; set debug to see each evaluation.
CONFIGDIRECTOR_LOG_LEVEL=info

# The folder the SDK keeps the values it received in, as an absolute path. The web server and
# php artisan configdirector:stream must use the same one. Defaults to a folder in the system temp
# directory that belongs to the system user running PHP.
# CONFIGDIRECTOR_STORAGE_PATH=/var/lib/my-app/configdirector
